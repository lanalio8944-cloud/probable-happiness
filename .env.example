# Public app origin, without a trailing slash.
APP_ORIGIN=http://localhost:3000

# Fixed HTTPS destination and exact hostname allowlist.
REDIRECT_DESTINATION=https://destination.example.com
REDIRECT_ALLOWED_HOSTS=destination.example.com

# Generate a random secret with at least 32 bytes, e.g. `openssl rand -base64 32`.
# Never expose this as a NEXT_PUBLIC_ variable or commit a real value.
SESSION_SECRET=replace-with-a-private-random-secret-at-least-32-bytes
